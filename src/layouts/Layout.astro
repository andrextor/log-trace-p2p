---
import "../styles/global.css";
interface Props {
	title?: string;
}
const { title = "log-trace-p2p // Visualizador de Trazas" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#050506] text-gray-300 font-sans selection:bg-indigo-500/30">
    <div class="fixed inset-0 z-[-1] bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]"></div>
    <div class="fixed inset-0 z-[-1] bg-[radial-gradient(circle_800px_at_50%_-100px,#1e1b4b,transparent)]"></div>

    <nav class="border-b border-white/5 bg-[#0a0a0b]/60 backdrop-blur-xl sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="group relative">
                    <div class="absolute -inset-1 bg-indigo-500 rounded-lg blur opacity-25 group-hover:opacity-50 transition"></div>
                    <div class="relative w-8 h-8 bg-[#0a0a0b] border border-white/10 rounded-lg flex items-center justify-center">
                        <span class="text-indigo-500 font-black text-xs">P2P</span>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-mono font-bold text-white text-sm tracking-tighter leading-none">log-trace-p2p</span>
                    <span class="text-[9px] text-gray-500 font-mono uppercase tracking-widest">Analyzer Engine</span>
                </div>
            </div>
            </div>
    </nav>

    <main class="relative">
        <slot />
    </main>
    </body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}
	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>